# Reference only. Codex must merge this into the app's root .env.example.
# Fill real values in Cloud environment variables OR untracked .env.local.
# No database password, sb_secret key, service_role key or GitHub token.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The app must explicitly read this into its Vite base configuration.
# Local default; use /project-china/ only for a matching approved Pages build.
VITE_BASE_PATH=/
